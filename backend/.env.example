# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Input limits
MAX_DRAFT_CHARS=10000
MAX_REFERENCE_ITEMS=200

# PostgreSQL Database Configuration
# Supported drivers: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/brandpilot

# JWT Authentication
JWT_SECRET_KEY=brandpilot_atelier_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Document Upload & Local Storage
DOCUMENT_STORAGE_DIR=storage/documents
MAX_UPLOAD_SIZE_BYTES=10485760

# Vector Embeddings & Retrieval
# Providers: mock | openai | openai_compatible | groq | off
# Set to 'mock' for fully deterministic, offline testing without paid API keys
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_RETRIEVED_PASSAGES=5

# Groq Cloud AI Configuration
# Paste your Groq API key below (starts with gsk_...)
GROQ_API_KEY=
AI_API_KEY=

# AI Provider: groq | openai_compatible | mock | off
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_REQUIRED=false

# Basic accessibility checks
ENABLE_ACCESSIBILITY_CHECKS=true
