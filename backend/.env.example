# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Input limits
MAX_DRAFT_CHARS=10000
MAX_REFERENCE_ITEMS=200

# Groq Cloud AI Configuration
# Paste your Groq API key below (starts with gsk_...)
GROQ_API_KEY=
AI_API_KEY=

# AI Provider: groq | openai_compatible | mock | off
# When GROQ_API_KEY is provided, it automatically connects to Groq Cloud
AI_PROVIDER=groq

# Groq Cloud OpenAI-compatible API endpoint
AI_BASE_URL=https://api.groq.com/openai/v1

# GPT model on Groq Cloud: openai/gpt-oss-120b (or openai/gpt-oss-20b)
AI_MODEL=openai/gpt-oss-120b

AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# If true, an AI failure returns HTTP 502 instead of graceful fallback
AI_REQUIRED=false

# Basic accessibility checks
ENABLE_ACCESSIBILITY_CHECKS=true
