# Copy to .env and fill in. NEVER commit .env.

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Input limits
MAX_DRAFT_CHARS=10000
MAX_REFERENCE_ITEMS=200

# AI review: mock | openai_compatible | off
#   mock              -> built-in heuristic reviewer, no API key needed (demo/tests)
#   openai_compatible -> any OpenAI-style /chat/completions API (set the 3 values below)
#   off               -> rule-based checks only
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1

# If true, an AI failure returns HTTP 502 instead of rule-only results + warning
AI_REQUIRED=false

# Basic rule-based accessibility checks
ENABLE_ACCESSIBILITY_CHECKS=true
